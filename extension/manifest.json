{
  "manifest_version": 3,
  "name": "yt-dlp Video Downloader",
  "version": "1.0.0",
  "description": "Download videos and audio from YouTube, Twitch, and 1000+ sites for free with zero limits using yt-dlp.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "yt-dlp Downloader",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytdlp-downloader@antigravity.local"
    }
  },
  "key": ""
}
